{
  "name": "timeywimey-web",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser-tests.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "mediabunny": "^1.61.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
